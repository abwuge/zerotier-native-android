#!/system/bin/sh

MODDIR=/data/adb/modules/zerotier-native
# shellcheck source=module/lib.sh
. "$MODDIR/lib.sh"
previous=
for argument in "$@"; do
    if [ "$previous" = join ]; then
        zerotier_init
        zerotier_configure_interface_name "$argument" || exit 1
        break
    fi
    previous=$argument
done
exec "$MODDIR/bin/zerotier-one" -q "-D$ZEROTIER_HOME" "$@"
